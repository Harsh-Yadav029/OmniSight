# ==============================================================================
# OmniSight Monorepo — Global Environment Template
# Copy this file to .env (or copy individual .env.example files inside each service)
# ==============================================================================

# --- AI Vision & Summarization Engine (Required for ML Service) ---
# Get your Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get your Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- GitHub Automation (Required for Auto-PR Creation) ---
# Fine-grained Personal Access Token with 'Contents' & 'Pull Requests' read/write access
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=Harsh-Yadav029/OmniSight

# --- Security & Microservice Authentication ---
# 64-character secret for signing user JWTs in Backend
JWT_SECRET=omnisight_jwt_super_secret_key_development_only_1234567890

# 32-character secret shared between ML Service and Backend for internal API calls
INTERNAL_API_KEY=omnisight_internal_secret_key_32_bytes_long

# --- Database & Cache URLs ---
MONGO_URI=mongodb://localhost:27017/omnisight
REDIS_URL=redis://localhost:6379/0

# --- Service Host URLs (Defaults for Localhost) ---
PORT=5000
BACKEND_URL=http://localhost:5000
TEST_TARGET_APP_URL=http://localhost:5173
VITE_BACKEND_URL=http://localhost:5000
VITE_PORT=5173
